diff --git a/drivers/mfd/axp20x.c b/drivers/mfd/axp20x.c
index c5f0ebae327f..d6d6e2a9e071 100644
--- a/drivers/mfd/axp20x.c
+++ b/drivers/mfd/axp20x.c
@@ -49,6 +49,35 @@ static const char * const axp20x_model_names[] = {
 	[AXP809_ID] = "AXP809",
 	[AXP813_ID] = "AXP813",
 	[AXP15060_ID] = "AXP15060",
+	[AXP8191_ID] = "AXP8191",
+};
+
+/* Staged AXP8191 support: only 8-bit bank-0 registers are accessible.
+ * No implicit page selection or write to undocumented high registers.
+ */
+/* Initial AXP8191 support: permit only registered boot-rail controls.
+ * 0x10 DCDC1 enable; 0x11 DC1SW2 enable; 0x12 DCDC1 voltage;
+ * 0x21 CLDO5 enable; 0x33 CLDO5 voltage.
+ * No IRQ writes, page switching, workmode or frequency programming.
+ */
+static const struct regmap_range axp8191_writeable_ranges[] = {
+	regmap_reg_range(AXP8191_DCDC_CTL1, AXP8191_DC1OUT_VOL),
+	regmap_reg_range(AXP8191_LDO_CTL2, AXP8191_LDO_CTL2),
+	regmap_reg_range(AXP8191_CLDO5OUT_VOL, AXP8191_CLDO5OUT_VOL),
+};
+
+static const struct regmap_range axp8191_volatile_ranges[] = {
+	regmap_reg_range(AXP8191_IRQ_STATUS1, AXP8191_IRQ_STATUS1 + 3),
+};
+
+static const struct regmap_access_table axp8191_writeable_table = {
+	.yes_ranges = axp8191_writeable_ranges,
+	.n_yes_ranges = ARRAY_SIZE(axp8191_writeable_ranges),
+};
+
+static const struct regmap_access_table axp8191_volatile_table = {
+	.yes_ranges = axp8191_volatile_ranges,
+	.n_yes_ranges = ARRAY_SIZE(axp8191_volatile_ranges),
 };
 
 static const struct regmap_range axp152_writeable_ranges[] = {
@@ -390,6 +419,17 @@ static const struct resource axp15060_pek_resources[] = {
 	DEFINE_RES_IRQ_NAMED(AXP15060_IRQ_PEK_FAL_EDGE, "PEK_DBF"),
 };
 
+static const struct regmap_config axp8191_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = 0x7f,
+	.wr_table = &axp8191_writeable_table,
+	.volatile_table = &axp8191_volatile_table,
+	.use_single_read = true,
+	.use_single_write = true,
+	.cache_type = REGCACHE_NONE,
+};
+
 static const struct regmap_config axp152_regmap_config = {
 	.reg_bits	= 8,
 	.val_bits	= 8,
@@ -1230,6 +1270,11 @@ static const struct mfd_cell axp15060_cells[] = {
 };
 
 /* For boards that don't have IRQ line connected to SOC. */
+/* AXP8191 first-stage registration is limited to three power rails. */
+static const struct mfd_cell axp8191_cells[] = {
+	MFD_CELL_BASIC("axp20x-regulator", NULL, NULL, 0, 1),
+};
+
 static const struct mfd_cell axp_regulator_only_cells[] = {
 	/* PMIC without IRQ line may be secondary PMIC */
 	MFD_CELL_BASIC("axp20x-regulator", NULL, NULL, 0, 1),
@@ -1365,6 +1410,12 @@ int axp20x_match_device(struct axp20x_dev *axp20x)
 		 */
 		axp20x->regmap_irq_chip = &axp803_regmap_irq_chip;
 		break;
+	case AXP8191_ID:
+		axp20x->nr_cells = ARRAY_SIZE(axp8191_cells);
+		axp20x->cells = axp8191_cells;
+		axp20x->regmap_cfg = &axp8191_regmap_config;
+		axp20x->regmap_irq_chip = NULL;
+		break;
 	case AXP15060_ID:
 		axp20x->nr_cells = ARRAY_SIZE(axp15060_cells);
 		axp20x->cells = axp15060_cells;
@@ -1434,7 +1485,7 @@ int axp20x_device_probe(struct axp20x_dev *axp20x)
 	}
 
 	/* Only if there is an interrupt line connected towards the CPU. */
-	if (axp20x->irq > 0) {
+	if (axp20x->irq > 0 && axp20x->variant != AXP8191_ID) {
 		ret = regmap_add_irq_chip(axp20x->regmap, axp20x->irq,
 				IRQF_ONESHOT | IRQF_SHARED | axp20x->irq_flags,
 				-1, axp20x->regmap_irq_chip,
@@ -1451,11 +1502,13 @@ int axp20x_device_probe(struct axp20x_dev *axp20x)
 
 	if (ret) {
 		dev_err(axp20x->dev, "failed to add MFD devices: %d\n", ret);
-		regmap_del_irq_chip(axp20x->irq, axp20x->regmap_irqc);
+		if (axp20x->regmap_irqc)
+			regmap_del_irq_chip(axp20x->irq, axp20x->regmap_irqc);
 		return ret;
 	}
 
-	if (axp20x->variant != AXP288_ID)
+	if (axp20x->variant != AXP288_ID &&
+	    axp20x->variant != AXP8191_ID)
 		devm_register_power_off_handler(axp20x->dev, axp20x_power_off, axp20x);
 
 	dev_info(axp20x->dev, "AXP20X driver loaded\n");
@@ -1467,7 +1520,8 @@ EXPORT_SYMBOL(axp20x_device_probe);
 void axp20x_device_remove(struct axp20x_dev *axp20x)
 {
 	mfd_remove_devices(axp20x->dev);
-	regmap_del_irq_chip(axp20x->irq, axp20x->regmap_irqc);
+	if (axp20x->regmap_irqc)
+		regmap_del_irq_chip(axp20x->irq, axp20x->regmap_irqc);
 }
 EXPORT_SYMBOL(axp20x_device_remove);
 
